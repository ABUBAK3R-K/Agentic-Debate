# LLM provider — swapping providers should never require a code change.
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Debate generation. Every participant in a debate uses these identical
# values; the only difference between agents is persona and position.
DEBATE_TEMPERATURE=0.8
DEBATE_TOP_P=1.0
DEBATE_MAX_TOKENS=500

# The judge runs cooler than the debaters so its scoring stays consistent.
JUDGE_TEMPERATURE=0.3
JUDGE_MAX_TOKENS=1500

# Persona compilation is extraction, not creation.
COMPILER_TEMPERATURE=0.4
COMPILER_MAX_TOKENS=1000

# ---- Provider pacing ----------------------------------------------------
# The limit a debate runs into is almost never requests per minute — it is
# TOKENS per minute. A free Groq key allows 1000 requests a *day* but only
# 8000 tokens a *minute*, and one debate turn costs one to three thousand of
# them, so nine turns spaced four seconds apart still run the budget dry.
#
# The real pacing is automatic: the backend reads the provider's own
# x-ratelimit-*-tokens headers and waits for the stated reset when the budget
# no longer covers the next request. This interval is just a floor underneath
# that, and does nothing on a provider that reports no budget. Set it to 0 on
# a paid key.
LLM_MIN_REQUEST_INTERVAL=4.0
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE=2.0
LLM_MAX_BACKOFF=60.0

# How long one call may spend waiting out rate limits, in seconds. A 429 is
# the provider naming the moment it will be ready, not a failure, so these
# waits are bounded by time rather than counted against LLM_MAX_RETRIES —
# otherwise a turn that only needed another thirty seconds is abandoned and
# the round comes back empty.
LLM_RATE_LIMIT_BUDGET=180.0

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/persona_arena

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Set to true to log every SQL statement.
SQL_ECHO=false
