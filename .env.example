# LLM provider — swapping providers should never require a code change.
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# How hard a reasoning model may think before answering: "low", "medium" or
# "high". Hidden reasoning is billed against the same tokens-per-minute
# ceiling as the answer and is several times its size on a debate turn, so on
# a reasoning model this is the largest single lever on how long a debate
# spends waiting out rate limits.
#
# Leave it EMPTY on a model that has no such setting — a provider rejects the
# whole request rather than ignoring the field. Groq's compound models answer
# `reasoning_effort` with a 400, for instance.
LLM_REASONING_EFFORT=

# ---- Choosing a free provider -------------------------------------------
# One debate is roughly eleven requests: two persona compilations, eight
# turns, one judge. Each turn replays the transcript so far, so the prompts
# grow round by round. What decides whether that fits is TOKENS PER MINUTE,
# and free tiers differ by two orders of magnitude on exactly that number.
#
# Measured against a free Groq key: openai/gpt-oss-120b allows 8,000 TPM,
# which one debate cannot fit inside, so a run stalls once for about a minute
# waiting for the window to reset. Groq's compound models advertise 70,000
# TPM but are the wrong tool here — they are agentic systems that wander off
# the JSON format mid-debate, and each malformed turn sends the recovery
# chain back for three more requests against a 30 RPM limit.
#
# Anything OpenAI-compatible is a change to this file alone: set
# LLM_BASE_URL, LLM_MODEL and LLM_API_KEY, and clear LLM_REASONING_EFFORT
# unless the model takes it. Gemini has its own provider already
# (LLM_PROVIDER=gemini). Confirm your own ceilings in the provider's console
# before assuming a published number still holds — free tiers move.

# Debate generation. Every participant in a debate uses these identical
# values; the only difference between agents is persona and position.
DEBATE_TEMPERATURE=0.8
DEBATE_TOP_P=1.0
DEBATE_MAX_TOKENS=500

# The judge runs cooler than the debaters so its scoring stays consistent.
# The model the judge runs on. Empty means the same one the debaters used,
# which is always correct and is the default.
#
# Naming a DIFFERENT model buys a second rate-limit budget where a provider
# meters per model as well as per key (Gemini free:
# GenerateRequestsPerMinutePerProjectPerModel). It moves the judge — the one
# request in a debate most likely to be refused, because it comes last, when
# the window is fullest — off the budget the eight turns compete for, taking
# a debate from nine requests against that budget to eight. Measured on
# Gemini free: three debates back to back in 96s rather than 120s, with a
# single debate no slower.
#
# Two things must be true of the model you name, and neither is safe to
# assume:
#   * it is not an ALIAS of the debaters' model. gemini-flash-lite-latest
#     resolves to gemini-3.5-flash-lite and shares its bucket, so the split
#     reads as configured and does nothing.
#   * it does not think. A thinking model bills that thinking against
#     JUDGE_MAX_TOKENS, and a budget that fits the thinking but not the JSON
#     yields a truncated verdict, a failed validation, and two more requests
#     on the recovery chain — the opposite of the point.
#
# This does not touch the "identical settings for every participant" rule.
# The judge is not a participant, and the PRD asks for the opposite: never
# let one debater's model instance judge the debate.
JUDGE_MODEL=

JUDGE_TEMPERATURE=0.3
JUDGE_MAX_TOKENS=1500

# Persona compilation is extraction, not creation.
COMPILER_TEMPERATURE=0.4
COMPILER_MAX_TOKENS=1000

# ---- Provider pacing ----------------------------------------------------
# The limit a debate runs into is almost never requests per minute — it is
# TOKENS per minute. A free Groq key allows 1000 requests a *day* but only
# 8000 tokens a *minute*, and one debate turn costs one to three thousand of
# them, so nine turns spaced four seconds apart still run the budget dry.
#
# The real pacing is automatic: the backend reads the provider's own
# x-ratelimit-*-tokens headers and waits for the stated reset when the budget
# no longer covers the next request. This interval is just a floor underneath
# that, and does nothing on a provider that reports no budget.
#
# Keep it small. It is charged to every request including persona
# compilation, which is the one call a user sits and watches, and it buys
# nothing the header-driven pacing above does not already do. Set it to 0 on
# a paid key.
LLM_MIN_REQUEST_INTERVAL=0.5

# Requests allowed per rolling minute, for a provider that meters REQUESTS
# rather than tokens and publishes no headers to pace against. Gemini's free
# tier is exactly that: its 429 names the quota outright —
#
#   quotaId : GenerateRequestsPerMinutePerProjectPerModel-FreeTier
#   limit   : 15   (per minute, per project, per model)
#
# Against a limit like that, cutting tokens buys nothing; only making fewer
# requests does. One debate is nine — eight turns and the judge — and the two
# persona compilations happen once per friend and are reused after.
#
# Prefer this over LLM_MIN_REQUEST_INTERVAL wherever a provider states a
# per-minute request quota, and leave the interval at 0. A window slows only
# the request that would actually be refused; an interval slows every request
# equally, including the nine that were always going to be allowed. Measured
# on Gemini free: one debate takes 17s under a window and 36s under the
# equivalent 4s interval, and neither is ever rate limited.
#
# 0 disables it.
LLM_REQUESTS_PER_MINUTE=0
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE=2.0
LLM_MAX_BACKOFF=60.0

# How long one call may spend waiting out rate limits, in seconds. A 429 is
# the provider naming the moment it will be ready, not a failure, so these
# waits are bounded by time rather than counted against LLM_MAX_RETRIES —
# otherwise a turn that only needed another thirty seconds is abandoned and
# the round comes back empty.
LLM_RATE_LIMIT_BUDGET=180.0

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/persona_arena

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Set to true to log every SQL statement.
SQL_ECHO=false
