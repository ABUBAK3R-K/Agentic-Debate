# LLM provider — swapping providers should never require a code change.
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Debate generation. Every participant in a debate uses these identical
# values; the only difference between agents is persona and position.
DEBATE_TEMPERATURE=0.8
DEBATE_TOP_P=1.0
DEBATE_MAX_TOKENS=500

# The judge runs cooler than the debaters so its scoring stays consistent.
JUDGE_TEMPERATURE=0.3
JUDGE_MAX_TOKENS=1500

# Persona compilation is extraction, not creation.
COMPILER_TEMPERATURE=0.4
COMPILER_MAX_TOKENS=1000

# ---- Provider pacing ----------------------------------------------------
# One debate is nine requests back to back. Free tiers meter per minute, so
# without a gap between them the run hits a 429 partway through and the rest
# of the rounds come back empty. Raise this if you still see 429s; set it to
# 0 on a paid key.
LLM_MIN_REQUEST_INTERVAL=4.0
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE=2.0
LLM_MAX_BACKOFF=60.0

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/persona_arena

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Set to true to log every SQL statement.
SQL_ECHO=false
